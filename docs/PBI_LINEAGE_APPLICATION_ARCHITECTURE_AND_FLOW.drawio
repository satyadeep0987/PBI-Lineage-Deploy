        <mxCell id="p-sub" parent="1" style="text;html=1;align=left;fontSize=14;fontColor=#5B6B85;" value="PowerAI explains app-collected lineage. It does not query credentials, run arbitrary SQL, change Power BI/Snowflake, or invent visual/source evidence." vertex="1">
