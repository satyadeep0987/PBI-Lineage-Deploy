        <mxCell id="n-home" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#10213D;fontSize=12;spacing=10;" value="&lt;b&gt;HOME&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Do:&lt;/b&gt; search accessible reports; open a report; choose Explore or Report Lineage; refresh inventory; reopen recent reports.&lt;br&gt;&lt;br&gt;&lt;b&gt;Returns:&lt;/b&gt; workspace/report/semantic-model counts, report cards, selected report context." vertex="1">
          <mxGeometry height="330" width="300" x="20" y="420" as="geometry" />
        </mxCell>
        <mxCell id="n-explore" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#10213D;fontSize=12;spacing=10;" value="&lt;b&gt;EXPLORE — workspace/report guided path&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Select:&lt;/b&gt; one or more workspaces, then reports.&lt;br&gt;&lt;br&gt;&lt;b&gt;Workspaces Inventory:&lt;/b&gt; workspace name/ID + CSV.&lt;br&gt;&lt;b&gt;Workspace Artifacts:&lt;/b&gt; Reports, Dashboards, Workspace Access + CSV.&lt;br&gt;&lt;b&gt;Lineage Analysis:&lt;/b&gt; Source DB Lineage; Semantic Model Objects; Measure Source Lineage.&lt;br&gt;&lt;b&gt;Visual Details:&lt;/b&gt; Report Layout; Visual Source Lookup.&lt;br&gt;&lt;b&gt;Visual Item Lineage:&lt;/b&gt; appears after layout metadata is available." vertex="1">
          <mxGeometry height="450" width="325" x="405" y="390" as="geometry" />
        </mxCell>
        <mxCell id="n-report" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#10213D;fontSize=12;spacing=10;" value="&lt;b&gt;REPORT LINEAGE — best report-first path&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Navigate:&lt;/b&gt; search by report/workspace/dataset ID → Open selected report.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lineage Analysis:&lt;/b&gt;&lt;br&gt;• Source DB Lineage — partitions, M/native SQL, physical sources&lt;br&gt;• Semantic Model Objects — tables, columns, measures, DAX&lt;br&gt;• Measure Source Lineage — DAX dependencies and mapped sources&lt;br&gt;• Download full report details — metadata ZIP&lt;br&gt;&lt;br&gt;&lt;b&gt;Visual Details:&lt;/b&gt; retrieve/authorize/upload report definition; pages, visuals, roles and fields.&lt;br&gt;&lt;b&gt;Visual Item Lineage:&lt;/b&gt; join visual → semantic object → source." vertex="1">
          <mxGeometry height="450" width="395" x="780" y="390" as="geometry" />
        </mxCell>
        <mxCell id="n-table" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=12;spacing=10;" value="&lt;b&gt;TABLE IMPACT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Select:&lt;/b&gt; workspace scope; searchable table suggestion or custom name; optional partial match; Fabric authorization for visual evidence.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scans:&lt;/b&gt; primary/upstream models, source tables, semantic dependencies, connected reports, cached/retrieved visual layouts.&lt;br&gt;&lt;br&gt;&lt;b&gt;Returns tabs:&lt;/b&gt;&lt;br&gt;• Affected Reports&lt;br&gt;• Measure Dependencies&lt;br&gt;Metrics, visual confirmation status, related errors, CSV downloads." vertex="1">
          <mxGeometry height="450" width="285" x="1215" y="390" as="geometry" />
        </mxCell>
        <mxCell id="n-measure" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=12;spacing=10;" value="&lt;b&gt;MEASURE IMPACT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Select:&lt;/b&gt; workspace scope; searchable measure suggestion or custom name; optional partial match; Fabric authorization for visual evidence.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scans:&lt;/b&gt; matching measures, reports, semantic dependencies, physical source mappings, primary/upstream models, visual layouts.&lt;br&gt;&lt;br&gt;&lt;b&gt;Returns tabs:&lt;/b&gt;&lt;br&gt;• Affected Reports&lt;br&gt;• Measure Lineage&lt;br&gt;Close-name suggestions, visual evidence, errors, CSV downloads." vertex="1">
